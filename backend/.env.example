# ---------------------------------------------------------------------------
# Ananta Events backend — copy to backend/.env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# Core ----------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev          # config.settings.prod in production
DEBUG=True
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1,api.your-domain.com
SITE_URL=http://localhost:5173                       # frontend origin
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL is required) ----------------------------------------
DATABASE_URL=postgres://ananta:ananta@localhost:5432/ananta
DB_CONN_MAX_AGE=60
DB_USE_POOL=False
CACHE_URL=locmemcache://ananta?timeout=300          # use redis://host:6379/1 in prod

# CORS / CSRF (comma separated, NO trailing slash) --------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://anata-events-jet.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://anata-events-jet.vercel.app

# Auth / tokens -------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=12
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=ananta_refresh
REFRESH_COOKIE_SECURE=False                          # True in production (HTTPS)
REFRESH_COOKIE_SAMESITE=Lax                          # "None" when the API is on another domain
REFRESH_COOKIE_DOMAIN=                                # e.g. .ananta-events.com
AUTH_COOKIE_PATH=/api/auth/
IDLE_TIMEOUT_MINUTES=30
LOGIN_THROTTLE_RATE=5/min
LOGIN_LOCKOUT_LIMIT=5
LOGIN_LOCKOUT_HOURS=1

# Email (console backend is used automatically when EMAIL_HOST is empty) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=23101055@uap-bd.edu
EMAIL_HOST_PASSWORD=kjfz yyoh sizd jmyi
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ananta Events <no-reply@ananta-events.com>
DJANGO_ADMINS=Owner,owner@ananta-events.com

# First admin (used by `python manage.py create_initial_admin`) -------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Super Admin

# Media storage -------------------------------------------------------------
# local (dev only) | cloudinary | s3
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Security (production) -----------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
FILE_UPLOAD_MAX_MB=10
THROTTLE_RATE_PUBLIC_FORM=10/hour
THROTTLE_RATE_PUBLIC_READ=240/min
SENTRY_DSN=
