# ---------------------------------------------------------------------------
# Ananta Events backend — copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Core
DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=your-backend.example.com,ananta-backend.vercel.app
# postgres://user:password@host:5432/dbname  (required when DEBUG=False)
DATABASE_URL=
CONN_MAX_AGE=60
# "disable" for local docker without TLS; managed providers usually need require/default
DB_SSLMODE=require

# Security / cookies
SECURE_COOKIES=True
SECURE_SSL_REDIRECT=False

# Frontend origins allowed to call the API with credentials
CORS_ALLOWED_ORIGINS=https://ananta-events-jet.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://ananta-events-jet.vercel.app,http://localhost:5173

# JWT lifetimes
ACCESS_TOKEN_MINUTES=12
REFRESH_TOKEN_DAYS=7

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# First super admin (used by: python manage.py create_initial_admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Change-me-12chars-min

# Email (SMTP). With the console backend, emails print to server logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ananta Events <no-reply@yourdomain.com>
# Where submission notifications go
ADMIN_EMAIL=info@anantabd.net

# Media storage: auto | cloudinary | s3 | local (auto detects the URLs below)
STORAGE_BACKEND=auto
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Where seed_demo_data reads the frontend JSON content (optional override)
SEED_SOURCE_DIR=
