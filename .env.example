# Frontend (Vite) environment — copy to .env and adjust.
# Leave VITE_API_BASE_URL empty/`/api` in production: vercel.json proxies
# /api/* to the Django backend so the refresh cookie stays first-party.
VITE_API_BASE_URL=/api

# Where the API lives during local development (used by the Vite dev proxy).
VITE_DEV_API_TARGET=http://localhost:8000

# Idle timeout for the admin session (minutes). The server enforces the
# token lifetimes; this only controls the client-side auto-logout.
VITE_IDLE_TIMEOUT_MINUTES=30
